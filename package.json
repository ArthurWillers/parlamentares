{
  "name": "parlamentares",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "nuxt build",
    "generate": "pnpm data:validate && nuxt generate && python -m pipeline.compress_public",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm generate",
    "data:collect": "python -m pipeline.collect",
    "data:validate": "python -m pipeline.verify",
    "data:test": "python -m unittest discover -s pipeline/tests -v"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.139",
    "@iconify-json/simple-icons": "^1.2.98",
    "@nuxt/ui": "^4.11.3",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.12"
  },
  "packageManager": "pnpm@12.9.1"
}
