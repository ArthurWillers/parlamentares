{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "1.2.0",
  "title": "Despesas de cota v1",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "memberId",
      "year",
      "month",
      "cents",
      "category",
      "categoryCode",
      "party",
      "partyReported",
      "inMandate",
      "supplier",
      "supplierId",
      "issuedAt",
      "documentId",
      "documentNumber",
      "documentType",
      "documentUrl",
      "portalUrl",
      "sourceUrl",
      "sourceRecord",
      "categoryOriginal"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "memberId": {
        "type": "string",
        "pattern": "^(camara|senado):[0-9]+$"
      },
      "year": {
        "type": "integer",
        "minimum": 2008
      },
      "month": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      },
      "cents": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "categoryCode": {
        "type": [
          "string",
          "null"
        ]
      },
      "party": {
        "type": "string",
        "minLength": 1
      },
      "partyReported": {
        "type": [
          "string",
          "null"
        ]
      },
      "inMandate": {
        "type": "boolean"
      },
      "supplier": {
        "type": "string"
      },
      "supplierId": {
        "type": [
          "string",
          "null"
        ]
      },
      "issuedAt": {
        "type": [
          "string",
          "null"
        ],
        "format": "date"
      },
      "documentId": {
        "type": [
          "string",
          "null"
        ]
      },
      "documentNumber": {
        "type": [
          "string",
          "null"
        ]
      },
      "documentType": {
        "type": [
          "string",
          "null"
        ]
      },
      "documentUrl": {
        "type": [
          "string",
          "null"
        ],
        "format": "uri"
      },
      "portalUrl": {
        "type": [
          "string",
          "null"
        ],
        "format": "uri"
      },
      "sourceUrl": {
        "type": "string",
        "format": "uri"
      },
      "sourceRecord": {
        "type": "string"
      },
      "categoryOriginal": {
        "type": [
          "string",
          "null"
        ]
      },
      "grossCents": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": -9007199254740991,
        "maximum": 9007199254740991,
        "description": "Centavos exatos quando representáveis. Frações de centavo do campo auxiliar permanecem apenas no valor original, sem arredondamento."
      },
      "grossAmountOriginal": {
        "type": [
          "string",
          "null"
        ],
        "description": "Texto monetário original publicado pela Câmara, preservado inclusive com precisão superior a duas casas decimais."
      },
      "disallowedCents": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": -9007199254740991,
        "maximum": 9007199254740991,
        "description": "Centavos exatos quando representáveis. Frações de centavo do campo auxiliar permanecem apenas no valor original, sem arredondamento."
      },
      "disallowedAmountOriginal": {
        "type": [
          "string",
          "null"
        ],
        "description": "Texto monetário original publicado pela Câmara, preservado inclusive com precisão superior a duas casas decimais."
      },
      "restitutionCents": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": -9007199254740991,
        "maximum": 9007199254740991,
        "description": "Centavos exatos quando representáveis. Frações de centavo do campo auxiliar permanecem apenas no valor original, sem arredondamento."
      },
      "restitutionAmountOriginal": {
        "type": [
          "string",
          "null"
        ],
        "description": "Texto monetário original publicado pela Câmara, preservado inclusive com precisão superior a duas casas decimais."
      }
    },
    "additionalProperties": true
  }
}
