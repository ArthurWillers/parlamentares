{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "1.2.0",
  "title": "Manifesto auditável v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "years",
    "profileIds",
    "files",
    "coverage",
    "sources",
    "collectionMode",
    "remuneration"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "years": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 2008
      }
    },
    "profileIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(camara|senado):[0-9]+$"
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chamber",
          "year",
          "status",
          "ongoing",
          "sourceUrl",
          "records",
          "cents",
          "latestMonth",
          "unattributed",
          "fetchedAt"
        ],
        "properties": {
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "latestMonth": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 12
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "fetchedAt",
          "sha256"
        ]
      }
    },
    "collectionMode": {
      "enum": [
        "live",
        "cached"
      ]
    },
    "remuneration": {
      "type": "object",
      "required": [
        "status",
        "reason"
      ]
    },
    "collectionPolicy": {
      "type": "object",
      "required": [
        "historicalReviewDays",
        "refreshFromYear"
      ],
      "properties": {
        "historicalReviewDays": {
          "const": 365
        },
        "refreshFromYear": {
          "type": "integer",
          "minimum": 2008
        }
      }
    }
  }
}
