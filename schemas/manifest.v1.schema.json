{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "1.1.0",
  "title": "Manifesto auditável v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "years",
    "profileIds",
    "files",
    "coverage",
    "sources",
    "collectionMode",
    "remuneration"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "years": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 2018
      }
    },
    "profileIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(camara|senado):[0-9]+$"
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chamber",
          "year",
          "status",
          "ongoing",
          "sourceUrl",
          "records",
          "cents",
          "latestMonth",
          "unattributed"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "fetchedAt",
          "sha256"
        ]
      }
    },
    "collectionMode": {
      "enum": [
        "live",
        "cached"
      ]
    },
    "remuneration": {
      "type": "object",
      "required": [
        "status",
        "reason"
      ]
    }
  }
}
