{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "1.0.0",
  "title": "Agregados por parlamentar/competência/partido/categoria v1",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "memberId",
      "year",
      "month",
      "cents",
      "category",
      "party",
      "inMandate",
      "count"
    ],
    "properties": {
      "memberId": {
        "type": "string",
        "pattern": "^(camara|senado):[0-9]+$"
      },
      "year": {
        "type": "integer",
        "minimum": 2018
      },
      "month": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      },
      "cents": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "party": {
        "type": "string",
        "minLength": 1
      },
      "inMandate": {
        "type": "boolean"
      },
      "count": {
        "type": "integer",
        "minimum": 1
      }
    },
    "additionalProperties": false
  }
}
